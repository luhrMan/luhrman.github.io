{
  "name": "luhrman.dev site",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "forwardPorts": [1313, 8080],
  "portsAttributes": {
    "1313": {
      "label": "Hugo server (Sqyre)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Production preview (/ and /sqyre/)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "files.associations": {
          "hugo.toml": "toml"
        }
      }
    }
  },
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && chmod +x scripts/*.sh && npm ci",
  "remoteUser": "vscode"
}
